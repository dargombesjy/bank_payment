<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:macros="sap.fe.macros"
  xmlns:f="sap.ui.layout.form">

  <Dialog id="dialog1" title="Input data" contentWidth="30rem" draggable="true" resizable="true">
    <content>
      <f:SimpleForm id="form1" editable="true">
        <Label id="label1" text="Date" />
        <DatePicker
          id="datePicker1"
          value="{
            path: 'popupModel>/erdat',
            type: 'sap.ui.model.type.Date',
            formatOptions: {
              style: 'medium',
              strictParsing: true
            }
          }"
          change=".onDateChange" />
        <!-- <Input id="input1" value="popupModel>/erdat"/> -->
        <Label id="label2" text="House Bank" />
        <macros:Field
          id="input1"
          metaPath="/com.sap.gateway.srvd.zsgi_fi_bank_payment.v0001.Container/ZSGI_FI_C_BANK_PAYMENT/HouseBank"
          value="{popupModel>/houseBank}"
          readOnly="false" />
        <!-- <Input id="input2" value="{popupModel>/houseBank}" showValueHelp="true"
          valueHelpRequest=".onBankRequest" /> -->
        <Label id="label3" text="House Bank Account" />
        <macros:Field
          id="input3"
          metaPath="/com.sap.gateway.srvd.zsgi_fi_bank_payment.v0001.Container/ZSGI_FI_C_BANK_PAYMENT/HouseBankAccount"
          value="{popupModel>/houseBankAccount}"
          readOnly="false" />
        <!-- <Input id="input3" value="{popupModel>/houseBankAccount}" showValueHelp="true"
          valueHelpRequest=".onAccountReq" /> -->
      </f:SimpleForm>
    </content>
    <beginButton>
      <Button id="button1" text="Process" type="Emphasized" press=".onConfirmPrint" />
    </beginButton>
    <endButton>
      <Button id="button2" text="Cancel" press=".onCancelPrint" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>